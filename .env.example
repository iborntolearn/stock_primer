# Copy to .env (same folder). Every setting is optional; the defaults are in core/settings.py.

# Claude
STOCK_PRIMER_ANTHROPIC_API_KEY=

# Telegram (bot + alerts)
STOCK_PRIMER_TELEGRAM_BOT_TOKEN=
STOCK_PRIMER_TELEGRAM_OWNER_CHAT_ID=

# Login: written by `python -m api.auth setup`; do not edit by hand
STOCK_PRIMER_AUTH_PASSWORD_HASH=
STOCK_PRIMER_AUTH_TOTP_SECRET=
STOCK_PRIMER_AUTH_SESSION_KEY=
STOCK_PRIMER_AUTH_SESSION_HOURS=12

# Optional bearer token for scripts calling the API directly on 127.0.0.1
STOCK_PRIMER_API_TOKEN=

# Backups: key from `python -m ops.backup keygen`; keep a copy outside this PC
STOCK_PRIMER_BACKUP_KEY=
STOCK_PRIMER_BACKUP_COPY_DIR=
